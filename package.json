{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/react-site",
    "apps/cms-api",
    "infra"
  ],
  "scripts": {
    "dev": "next dev",
    "site": "node scripts/site-dev.mjs",
    "dev:react": "npm run dev -w @dancer-citizen/react-site",
    "dev:api": "npm run dev -w @dancer-citizen/cms-api",
    "build:react": "npm run build -w @dancer-citizen/react-site",
    "build:api": "npm run build -w @dancer-citizen/cms-api",
    "test:api": "npm run test -w @dancer-citizen/cms-api",
    "cdk:synth": "npm run synth -w @dancer-citizen/infra",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prismic:login": "node scripts/prismic-login.mjs",
    "scaffold:slices": "node scripts/scaffold-slices.cjs",
    "slicemachine": "start-slicemachine -p 9999"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1075.0",
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/client-ses": "^3.1075.0",
    "@prismicio/client": "^7.21.8",
    "@prismicio/next": "^2.2.3",
    "@prismicio/react": "^3.4.1",
    "@prismicio/simulator": "^0.2.1",
    "@prismicio/types": "^0.2.9",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@slicemachine/adapter-next": "^0.3.95",
    "@tailwindcss/postcss": "^4",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-cdk": "^2.1018.0",
    "aws-cdk-lib": "^2.258.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "react-router-dom": "^7.8.2",
    "slice-machine-ui": "^2.21.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}

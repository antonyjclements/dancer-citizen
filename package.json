{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/react-site",
    "apps/cms-api",
    "infra"
  ],
  "scripts": {
    "dev": "npm run site",
    "site": "node scripts/site-dev.mjs",
    "dev:react": "npm run dev -w @dancer-citizen/react-site",
    "dev:api": "npm run dev -w @dancer-citizen/cms-api",
    "build:react": "npm run build -w @dancer-citizen/react-site",
    "build:api": "npm run build -w @dancer-citizen/cms-api",
    "test:api": "npm run test -w @dancer-citizen/cms-api",
    "cdk:synth": "npm run synth -w @dancer-citizen/infra",
    "build": "npm run build:react && npm run build:api",
    "lint": "eslint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "eslint": "^9",
    "husky": "^9.1.7",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0"
  }
}

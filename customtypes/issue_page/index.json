{
  "id": "issue_page",
  "label": "Issue Page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": "issue-page"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title",
          "placeholder": "Issue title"
        }
      },
      "issue_number": {
        "type": "Number",
        "config": {
          "label": "Issue number",
          "placeholder": "20"
        }
      },
      "publication_date": {
        "type": "Date",
        "config": {
          "label": "Publication date"
        }
      },
      "hero_title": {
        "type": "Text",
        "config": {
          "label": "Hero title"
        }
      },
      "hero_subtitle": {
        "type": "Text",
        "config": {
          "label": "Hero subtitle"
        }
      },
      "hero_image": {
        "type": "Image",
        "config": {
          "label": "Hero image"
        }
      },
      "hero_image_credit": {
        "type": "StructuredText",
        "config": {
          "label": "Hero image credit",
          "single": "paragraph"
        }
      },
      "body": {
        "type": "Slices",
        "fieldset": "Body",
        "config": {
          "choices": {
            "RichTextSection": {
              "type": "SharedSlice"
            },
            "LinkedTiles": {
              "type": "SharedSlice"
            },
            "Quote": {
              "type": "SharedSlice"
            },
            "Image": {
              "type": "SharedSlice"
            },
            "Gallery": {
              "type": "SharedSlice"
            },
            "VideoEmbed": {
              "type": "SharedSlice"
            },
            "FileLink": {
              "type": "SharedSlice"
            },
            "FormEmbed": {
              "type": "SharedSlice"
            }
          }
        }
      }
    },
    "Settings": {
      "hide_from_sitemap": {
        "type": "Boolean",
        "config": {
          "label": "Hide from sitemap",
          "default_value": false
        }
      },
      "tile_title": {
        "type": "Text",
        "config": {
          "label": "Tile title"
        }
      },
      "tile_summary": {
        "type": "StructuredText",
        "config": {
          "label": "Tile summary",
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "tile_thumbnail": {
        "type": "Image",
        "config": {
          "label": "Tile thumbnail"
        }
      }
    }
  }
}

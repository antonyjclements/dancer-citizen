{
  "id": "Quote",
  "type": "SharedSlice",
  "name": "Quote",
  "description": "Pull quote with optional attribution",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "Pull quote with optional attribution",
      "docURL": "https://prismic.io/docs/slices",
      "version": "initial",
      "primary": {
        "hide": {
          "type": "Boolean",
          "config": {
            "label": "Hide",
            "default_value": false
          }
        },
        "quote": {
          "type": "StructuredText",
          "config": {
            "label": "Quote",
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "attribution": {
          "type": "Text",
          "config": {
            "label": "Attribution",
            "placeholder": "Quote source"
          }
        },
        "centered": {
          "type": "Boolean",
          "config": {
            "label": "Centered",
            "default_value": false
          }
        }
      },
      "items": {}
    }
  ]
}

{
  "id": "BiographyList",
  "type": "SharedSlice",
  "name": "BiographyList",
  "description": "Contributor biographies with optional related article",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "Contributor biographies with optional related article",
      "docURL": "https://prismic.io/docs/slices",
      "version": "initial",
      "primary": {
        "heading": {
          "type": "Text",
          "config": {
            "label": "Heading",
            "placeholder": "Section heading"
          }
        }
      },
      "items": {
        "name": {
          "type": "Text",
          "config": {
            "label": "Name",
            "placeholder": "Contributor name"
          }
        },
        "summary": {
          "type": "StructuredText",
          "config": {
            "label": "Summary",
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item,heading2,heading3"
          }
        },
        "image": {
          "type": "Image",
          "config": {
            "label": "Image"
          }
        },
        "linked_article": {
          "type": "Link",
          "config": {
            "label": "Linked article",
            "select": "document"
          }
        }
      }
    }
  ]
}
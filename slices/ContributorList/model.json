{
  "id": "ContributorList",
  "type": "SharedSlice",
  "name": "ContributorList",
  "description": "Issue contributor cards with metadata and links",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "description": "Issue contributor cards with metadata and links",
      "docURL": "https://prismic.io/docs/slices",
      "version": "initial",
      "primary": {
        "heading": {
          "type": "Text",
          "config": {
            "label": "Heading",
            "placeholder": "Section heading"
          }
        }
      },
      "items": {
        "title_link": {
          "type": "Text",
          "config": {
            "label": "Title link",
            "placeholder": "Primary linked title"
          }
        },
        "issue": {
          "type": "Text",
          "config": {
            "label": "Issue",
            "placeholder": "Issue label"
          }
        },
        "thumbnail": {
          "type": "Image",
          "config": {
            "label": "Thumbnail"
          }
        },
        "body_text": {
          "type": "StructuredText",
          "config": {
            "label": "Body text",
            "multi": "paragraph,strong,em,hyperlink,list-item,o-list-item,heading2,heading3"
          }
        },
        "link_label": {
          "type": "Text",
          "config": {
            "label": "Link label",
            "placeholder": "Optional link label"
          }
        },
        "link": {
          "type": "Link",
          "config": {
            "label": "Link",
            "select": "web"
          }
        }
      }
    }
  ]
}
